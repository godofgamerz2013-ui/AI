# Use a separate generated gateway key; never commit real values.
GATEWAY_API_KEY=replace_with_a_long_random_secret
REQUEST_TIMEOUT_SECONDS=90
MAX_OUTPUT_TOKENS=4096

# Official/server API adapters. Configure any provider(s) you actually use.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
GOOGLE_API_KEY=
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/auto
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Unified Multi-AI Gateway
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile
TOGETHER_API_KEY=
TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-3-5-haiku-latest

# Optional WEBSITE GUI adapters. Each must attach to a user-signed-in Chromium via PRIVATE CDP.
# Keep ports 9222 etc. private; never expose a remote-debugging port to the public internet.
CHATGPT_GUI_CDP_URL=
CHATGPT_GUI_CHAT_URL=https://chatgpt.com/
CHATGPT_GUI_INPUT_SELECTOR=
CHATGPT_GUI_SEND_SELECTOR=
CHATGPT_GUI_RESPONSE_SELECTOR=
CHATGPT_GUI_MODELS=chatgpt-web
CHATGPT_GUI_TIMEOUT_SECONDS=120

CLAUDE_GUI_CDP_URL=
CLAUDE_GUI_CHAT_URL=https://claude.ai/new
CLAUDE_GUI_INPUT_SELECTOR=
CLAUDE_GUI_SEND_SELECTOR=
CLAUDE_GUI_RESPONSE_SELECTOR=
CLAUDE_GUI_MODELS=claude-web
CLAUDE_GUI_TIMEOUT_SECONDS=120

GEMINI_GUI_CDP_URL=
GEMINI_GUI_CHAT_URL=https://gemini.google.com/app
GEMINI_GUI_INPUT_SELECTOR=
GEMINI_GUI_SEND_SELECTOR=
GEMINI_GUI_RESPONSE_SELECTOR=
GEMINI_GUI_MODELS=gemini-web
GEMINI_GUI_TIMEOUT_SECONDS=120
