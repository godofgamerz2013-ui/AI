# Copy to .env.localai and replace all placeholder secrets locally.
# Do not commit .env.localai; only this example file belongs in Git.
GATEWAY_API_KEY=replace-with-a-long-random-gateway-secret

# Add whichever cloud API credentials you actually have. Empty values disable them.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODELS=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-3-5-haiku-latest
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/auto

# LocalAI is protected with this token on the Docker-internal network.
LOCALAI_API_KEY=replace-with-a-different-long-localai-secret
LOCALAI_BASE_URL=http://localai:8080/v1
LOCALAI_MODELS=qwen3-4b
LOCALAI_THREADS=4
LOCALAI_CONTEXT_SIZE=4096

# Change order only if you want another fallback sequence.
PROVIDER_FALLBACK_ORDER=openai,google,deepseek,anthropic,openrouter,localai
CORS_ORIGINS=http://localhost:8081
REQUEST_TIMEOUT_SECONDS=90
MAX_OUTPUT_TOKENS=4096
